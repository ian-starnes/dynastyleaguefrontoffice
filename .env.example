# Sleeper league DLFO reads player/roster data from.
# Find this in your league's Sleeper URL: sleeper.com/leagues/<LEAGUE_ID>/...
NEXT_PUBLIC_SLEEPER_LEAGUE_ID=

# Your Sleeper user_id within that league — powers the "My Team" filter.
# Find it via https://api.sleeper.app/v1/league/<LEAGUE_ID>/users. Optional.
NEXT_PUBLIC_SLEEPER_MY_OWNER_ID=
